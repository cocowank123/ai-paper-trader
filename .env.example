# =============================================================================
# Copy this file to ".env" and fill in your values, then NEVER commit .env.
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)
# The code reads these automatically. Your API key stays out of the source code.
# =============================================================================

# REQUIRED — your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# --- Everything below is optional; sensible defaults are used if left blank ---

# Which market to watch (any symbol your exchange supports)
SYMBOL=BTC/USDT
EXCHANGE=binance
TIMEFRAME=1h

# The AI model for news + trend analysis (Haiku = cheapest, ideal for this)
MODEL=claude-haiku-4-5

# How sure the AI must be (0-100) before the tool takes a trade
MIN_CONFIDENCE=60

# Risk settings (these mirror the Pine Script you backtested)
POSITION_FRACTION=0.20    # use 20% of equity per trade
ATR_MULT=2.0              # stop distance = 2x ATR
REWARD_RISK=1.5           # take-profit = 1.5x the stop distance

# Simulated starting balance (fake money)
STARTING_EQUITY=10000

# How often the loop runs, in minutes
INTERVAL_MINUTES=60

# How far back to read news, and how many headlines to feed the AI
NEWS_LOOKBACK_HOURS=12
NEWS_MAX_ITEMS=25
